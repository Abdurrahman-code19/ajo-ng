# Copy to .env and fill in. .env is gitignored and excluded from the image
# build; a secret in a layer survives in the image history even if a later step
# deletes it.
#
# The API refuses to start if PGUSER, PGPASSWORD or REDIS_URL is missing. There
# are no credential defaults, because a default credential is a guess.

# --- required: database -----------------------------------------------------
# The application login, NOT the migration role. It is NOSUPERUSER, NOBYPASSRLS
# and holds only ajo_app. Connecting as anything else makes every RLS policy
# decorative. See docs/deployment.md.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=ajo
PGUSER=ajo_api
# Provisioned by scripts/bootstrap_roles.sql in development, by your platform's
# secret store in production. The bootstrap's placeholder is `local-dev-only`
# and must not be used outside a laptop.
PGPASSWORD=local-dev-only
# PGPOOL_MAX=10

# --- required: rate limiter -------------------------------------------------
# Fails closed: if Redis is unreachable, registration returns 503 rather than
# proceeding unbounded.
REDIS_URL=redis://127.0.0.1:6379

# --- required in production: mail relay -------------------------------------
# All three or none. Half-configured is refused at boot, because a relay with a
# URL and no token fails on the first signup -- in production, found by a member.
# With NODE_ENV=production and none of these set, the process will not start:
# the only other sender writes the plaintext verification token to stdout.
# MAIL_RELAY_URL=https://relay.example.ng/send
# MAIL_RELAY_TOKEN=
# MAIL_FROM=no-reply@example.ng

# --- required in production: access-token signing key -----------------------
# An Ed25519 pair. Both halves or neither: half-configured is refused at boot.
#
#   openssl genpkey -algorithm ed25519 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
#
# The private half is PKCS#8 ("BEGIN PRIVATE KEY") and the public half SPKI
# ("BEGIN PUBLIC KEY"). The API signs access tokens with the first and verifies
# with the second -- the verifier is built from the public key, so a process that
# can only check tokens cannot mint them.
#
# Required when NODE_ENV=production. With neither variable set the API generates
# a key at boot, which is convenient locally and wrong in production: two
# instances would sign with different keys, so a member's token would be accepted
# by one and rejected by the other and a load balancer would log people out at
# random. The process refuses to start rather than find that out later.
# ACCESS_TOKEN_PRIVATE_KEY=
# ACCESS_TOKEN_PUBLIC_KEY=

# --- environment ------------------------------------------------------------
# production selects the relay and the health behaviour. Leave unset locally.
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=3000
# LOG_LEVEL=info

# Signup limit, per client address. The only bound on this write path.
# REGISTRATION_RATE_LIMIT=5
# REGISTRATION_WINDOW_MS=3600000

# Sign-in limits, per client address and per account. Two budgets: the first
# bounds one host spraying many addresses, the second bounds a distributed spray
# at a single member, which no per-address limit can see. Defaults are 10
# attempts per 15 minutes on each.
# LOGIN_RATE_LIMIT=10
# LOGIN_WINDOW_MS=900000

# Concurrent sessions per member (12.4.3). Signing in on a sixth device revokes
# the oldest. Signing in on a device already in use replaces that session.
# MAX_SESSIONS=5

# --- payment provider webhooks ----------------------------------------------
# POST /api/v1/webhooks/payments/:provider. The value is the HMAC key the
# provider signs deliveries with; the handler verifies the raw body before
# parsing it. A provider with no secret set is a provider that is switched OFF
# -- the endpoint answers 404 -- and there is deliberately no default, because a
# default signing key is a forged delivery waiting to happen.
#
# PROVIDUSUNITY_WEBHOOK_SECRET is the business name. Whether it is the live
# integration is not settled (E3-01), so leaving it unset is the correct state
# until the vendor contract lands. `mock` exists to exercise the pipeline.
# MOCK_WEBHOOK_SECRET=
# PROVIDUSUNITY_WEBHOOK_SECRET=

# Webhook deliveries per minute per provider. A separate rate-limit namespace
# from registration and login, because a provider's retry storm is not a person
# and the two must not exhaust each other's budget. Defaults 120 per 60000 ms.
# WEBHOOK_RATE_LIMIT=120
# WEBHOOK_WINDOW_MS=60000
