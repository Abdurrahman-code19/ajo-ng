{
  "name": "ajo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force && tsc --noEmit -p packages/domain/tsconfig.test.json && tsc --noEmit -p packages/api/tsconfig.test.json",
    "test": "tsc -p packages/domain/tsconfig.test.json && node --test packages/domain/build-test/test/",
    "test:unit:api": "tsc -p packages/api/tsconfig.test.json && node --test packages/api/build-test/test/unit.test.js",
    "test:db": "python3 scripts/test_migrations.py",
    "test:api": "python3 scripts/test_api.py",
    "verify": "npm run typecheck && npm test && npm run test:unit:api",
    "prepare": "bash scripts/install-hooks.sh",
    "postinstall": "bash scripts/install-hooks.sh"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.5.4"
  }
}
